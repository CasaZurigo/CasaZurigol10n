  "targetLanguages": [
    "en",
    "fr",
    "es",
    "it",
    "pt-PT",
    "he",
    "zh-HANS",
    "zh-HANT",
    "tr",
    "ru",
    "uk",
    "ko",
    "pl"
  ],
  "source": {
    "path": "./translations/reactnative/de.json",
    "type": "json"
  },
  "outputs": [
    {
      "type": "strings",
      "path": "./translations/ios/{lang}.lproj/Localizable.strings"
    },
    {
      "type": "json",
      "path": "./translations/reactnative/{lang}.json"
    }
  ],
  "include": ["../android/**/*.{ts,tsx,js,jsx}", "../ios/**/*.swift"],
  "extractPattern": "tr\\(\\s*(?:\"([^\"]*)\"|'([^']*)'|`([^`]*)`)\\s*[,)]",
  "exclude": [
    "../android/node_modules/**",
    "../android/.expo/**",
    "../android/assets/**",
    "../ios/CasaZurigo.xcodeproj/**",
    "../ios/CasaZurigo/Assets.xcassets/**"
  ],
  "translations": [
    { "provider": "deepl", "formality": "prefer_less" },
    { "provider": "google-translate" }
  ],
  "refiner": {
    "provider": "google-ai",
    "model": "gemini-3.8-flash",
    "systemPrompt": "You are a professional translator and localization expert. The source language is Swiss Standard German (Schweizer Hochdeutsch). Translate from that German source into the target language. Keep the meaning exact. German is the source because it names things more specifically than English. Use a direct, personal, informal tone. Address the user in the familiar form, never the formal form. The German source never uses ß. It always writes ss. It prefers Swiss terms over German-German ones. Match that local Swiss vocabulary in the target when a local equivalent exists. Action labels written as a German infinitive use the infinitive in fr, es, pt-PT, ru and uk and the imperative in it, pl and tr, and a German imperative stays an imperative in those languages; en, he, ko, zh-HANS and zh-HANT keep their usual UI form for buttons. A German infinitive ending in a question mark asks the user to confirm, so phrase it as a natural yes or no question, not as an action label. In Hebrew, use full spelling, address the user in the masculine singular, never in the plural, never use niqqud, phrase the developer's first-person sentences without gendered verb forms, and write German infinitive labels as an infinitive or an action noun, while German imperatives stay imperatives. In Korean, write every sentence in the polite 해요체 (-요); never use 반말, -습니다, 당신, or honorific address terms, and leave the word you implicit. In Turkish, never attach a case suffix to a placeholder, because its vowel depends on the value, so phrase around it instead, and separate a suffix from a capitalized name with an apostrophe. Use sentence case in every language: capitalize only the first word, proper nouns, app names, and words the language's grammar capitalizes. When the source starts lowercase, it continues other text, so start the translation lowercase too. Preserve placeholders exactly as they appear. Preserve escape sequences. Use the same trailing punctuation as the source. Return ONLY the translated text. No explanations. No quotes."
  },
