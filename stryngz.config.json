  "source": {
    "path": "./translations/reactnative/de.json",
    "type": "json"
  },
  "outputs": [
    {
      "type": "strings",
      "path": "./translations/ios/{lang}.lproj/Localizable.strings"
    },
    {
      "type": "json",
      "path": "./translations/reactnative/{lang}.json"
    }
  ],
  "include": ["../android/**/*.{ts,tsx,js,jsx}", "../ios/**/*.swift"],
  "extractPattern": "tr\\(\\s*(?:\"([^\"]*)\"|'([^']*)'|`([^`]*)`)\\s*[,)]",
  "exclude": [
    "../android/node_modules/**",
    "../android/.expo/**",
    "../android/assets/**",
    "../ios/CasaZurigo.xcodeproj/**",
    "../ios/CasaZurigo/Assets.xcassets/**"
